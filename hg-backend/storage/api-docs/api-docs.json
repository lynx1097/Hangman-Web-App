    "components": {
        "schemas": {
            "UserResource": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Jane Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "jane@example.com"
                    }
                },
                "type": "object"
            },
            "AuthResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Login successful"
                    },
                    "access_token": {
                        "type": "string",
                        "example": "1|abc..."
                    },
                    "token_type": {
                        "type": "string",
                        "example": "Bearer"
                    },
                    "user": {
                        "$ref": "#/components/schemas/UserResource"
                    }
                },
                "type": "object"
            },
            "GameState": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 42
                    },
                    "masked_word": {
                        "type": "string",
                        "example": "_ A _ G _ A _"
                    },
                    "word_length": {
                        "type": "integer",
                        "example": 7
                    },
                    "guessed_letters": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "A",
                            "G"
                        ]
                    },
                    "wrong_guesses": {
                        "type": "integer",
                        "example": 2
                    },
                    "max_wrong_guesses": {
                        "type": "integer",
                        "example": 6
                    },
                    "remaining_attempts": {
                        "type": "integer",
                        "example": 4
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "in_progress",
                            "won",
                            "lost"
                        ],
                        "example": "in_progress"
                    },
                    "score": {
                        "type": "integer",
                        "example": 0
                    },
                    "elapsed_seconds": {
                        "type": "integer",
                        "example": null,
                        "nullable": true
                    },
                    "hint": {
                        "type": "string",
                        "example": "A large grey mammal",
                        "nullable": true
                    },
                    "category": {
                        "type": "string",
                        "example": "animal"
                    },
                    "word": {
                        "description": "Only present when the game is finished",
                        "type": "string",
                        "example": "ELEPHANT",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "LeaderboardEntry": {
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Jane Doe"
                    },
                    "total_score": {
                        "type": "integer",
                        "example": 1250
                    },
                    "games_won": {
                        "type": "integer",
                        "example": 10
