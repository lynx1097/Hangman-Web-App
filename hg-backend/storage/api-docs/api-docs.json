                        "application/json": {
                            "schema": {
                                "required": [
                                    "current_password",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "current_password": {
                                        "type": "string",
                                        "example": "oldPass1"
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 6,
                                        "example": "newPass1"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "example": "newPass1"
                                    }
                                },
                                "type": "object"
